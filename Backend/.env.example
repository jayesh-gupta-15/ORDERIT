# ---- Server ----
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins when the frontend is hosted elsewhere.
# Leave empty if the frontend is served by this backend (same origin).
CORS_ORIGINS=
TRUST_PROXY=false

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_delivery_system
DB_POOL_SIZE=10

# ---- Security ----
# Use a long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Passcodes for the staff apps (the schema has no staff credentials). CHANGE THESE.
MANAGER_PASSCODE=manager123
RIDER_PASSCODE=rider123

# ---- Business rules ----
MAX_QTY_PER_ITEM=20
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_15MIN=40
